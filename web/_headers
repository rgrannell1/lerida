# Cloudflare Pages headers. The service worker and HTML shell must always be
# revalidated so a new deploy is picked up promptly; the content-hashed bundles
# under /dist are immutable and can be cached forever.

/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/dist/*
  Cache-Control: public, max-age=31536000, immutable
